// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id Int @id @default(autoincrement())

  username String
  email    String @unique

  results UserResult[]
}
enum GridSize {
  GRID_3X3
  GRID_4X4
  GRID_5X5
}
model Item {
  id       Int    @id @default(autoincrement())
  name     String
  category String
  rarity   String

  imageUrl String?

  gridSize GridSize
  revealOrder Json

  dailyPuzzles DailyPuzzle[]
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model DailyPuzzle {
  id Int @id @default(autoincrement())

  date DateTime

  difficulty Difficulty

  itemId Int
  item   Item @relation(fields: [itemId], references: [id])

  results UserResult[]

  @@unique([date, difficulty])
}

model UserResult {
  id Int @id @default(autoincrement())

  userId Int
  user   User @relation(fields: [userId], references: [id])

  dailyPuzzleId Int
  dailyPuzzle   DailyPuzzle @relation(fields: [dailyPuzzleId], references: [id])

  guesses Int

  completedAt DateTime?

  @@unique([userId, dailyPuzzleId])
}
